# Keep LF in the working tree (Go / Linux CI). Avoids Windows autocrlf noise.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.o binary
*.bin binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.7z binary
*.wasm binary
