# sing-box server configuration
SERVER_ENDPOINT=46.246.98.134
SERVER_PORT=443

# Premium server (optional — falls back to SERVER_ENDPOINT if not set)
#PREMIUM_SERVER_ENDPOINT=
#PREMIUM_SERVER_PORT=443

# Reality TLS configuration
# Generate with: bash nullvpn/config/generate_reality_keys.sh
REALITY_PUBLIC_KEY=YOUR_REALITY_PUBLIC_KEY_HERE
REALITY_SHORT_ID=YOUR_SHORT_ID_HERE
REALITY_SNI=www.cloudflare.com

# GitHub provisioning channel
PROVISIONER_SECRET=generate-with-openssl-rand-hex-32
REGISTRY_GITHUB_PAT=github_pat_XXXXXXXX
REGISTRY_GITHUB_REPO=nullvpnnet/nullvpn-registry

# UUID salt for deterministic per-device UUID generation
UUID_SALT=change-this-to-a-random-value
